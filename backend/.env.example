PORT=5000
NODE_ENV=development
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER/DATABASE
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
# Used only by npm run make-admin for an existing account.
ADMIN_PHONE=
# Optional legacy email-admin provisioning (password at least 12 characters).
ADMIN_EMAIL=
ADMIN_PASSWORD=
RESTAURANT_LAT=
RESTAURANT_LNG=
RESTAURANT_OPEN_TIME=
RESTAURANT_CLOSE_TIME=
# Comma-separated frontend origins; no path or trailing slash.
CORS_ORIGIN=http://localhost:8080
