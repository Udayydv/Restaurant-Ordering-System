# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file (it's already in .gitignore).

# Server
PORT=5000
NODE_ENV=development

# MongoDB
# Local dev:   mongodb://127.0.0.1:27017/TripathiRestaurant
# Atlas prod:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/TripathiRestaurant?retryWrites=true&w=majority
MONGO_URI=your_mongodb_connection_string_here

# JWT
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters
JWT_EXPIRES_IN=7d

# The phone number (10 digits, no country code) that automatically
# becomes an admin the moment it registers or logs in.
ADMIN_PHONE=9999999999

# Restaurant's exact coordinates, used to calculate distance-based
# delivery fees (0-3km ₹5, 3-7km ₹15, 7-10km ₹30, beyond 10km not
# deliverable). Get these from Google Maps (right-click the pin ->
# copy coordinates).
RESTAURANT_LAT=25.3176
RESTAURANT_LNG=82.9739

# Operating hours (24-hour HH:MM, interpreted in IST) — orders outside
# this window are rejected server-side and customers see a "we're
# closed" page instead of the site.
RESTAURANT_OPEN_TIME=08:00
RESTAURANT_CLOSE_TIME=22:00

# Comma-separated list of frontend origins allowed to call this API
# (also used for the Socket.io real-time connection).
# Local dev works without setting this (defaults to localhost:8080/8081/3000).
# In production, set this to your deployed frontend URL:
#   CORS_ORIGIN=https://your-frontend.vercel.app
CORS_ORIGIN=
